# Healthd / charger battery and charger sysfs (healthd reads
# present/capacity/voltage_now/current_now/charge_full).  The label is
# applied to the sysfs power_supply directory so all children inherit it.
genfscon sysfs /class/power_supply                                       u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/i2c-gpio.5/i2c-5/5-0006/power_supply     u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/i2c-gpio.7/i2c-7/7-0036/power_supply     u:object_r:sysfs_batteryinfo:s0

# storaged reads /sys/block/mmcblk0/stat.
genfscon sysfs /block/mmcblk0/stat                                       u:object_r:sysfs_disk_stat:s0
genfscon sysfs /devices/platform/omap_hsmmc.1/mmc_host/mmc0/mmc0:0001/block/mmcblk0/stat u:object_r:sysfs_disk_stat:s0

# system_server (batterystats) reads /proc/wakelocks
genfscon proc /wakelocks                                                  u:object_r:proc_wakelocks:s0

# init.espresso.rc writes the swappiness tuning knob (proc_dirty is the
# generic "vm tuning" label stock grants init write access to)
genfscon proc /sys/vm/swappiness                                          u:object_r:proc_dirty:s0

# Input sensors (init writes distortion etc.)
genfscon sysfs /class/input                                              u:object_r:sysfs_input:s0
genfscon sysfs /devices/platform/omap_i2c.4/i2c-4/4-002e/input           u:object_r:sysfs_input:s0

# Block queue (init writes read_ahead_kb)
genfscon sysfs /block/mmcblk0/queue                                      u:object_r:sysfs_block:s0
genfscon sysfs /devices/platform/omap_hsmmc.1/mmc_host/mmc0/mmc0:0001/block/mmcblk0/queue u:object_r:sysfs_block:s0

# KSM (init writes ksm parameters)
genfscon sysfs /kernel/mm/ksm                                            u:object_r:sysfs_ksm:s0

# USB gadget
genfscon sysfs /devices/platform/musb-omap2430/musb-hdrc/gadget/lun0     u:object_r:sysfs_gadget:s0

# bcmdhd firmware path (wifi HAL)
genfscon sysfs /module/bcmdhd/parameters/firmware_path                   u:object_r:sysfs_wlan_fwpath:s0
