/sys/devices/platform/omap_hsmmc.1/mmc_host/mmc0/mmc0:0001/block/mmcblk0/queue(/.*)? u:object_r:sysfs_block:s0

# KSM (init writes ksm parameters)
/sys/kernel/mm/ksm(/.*)?                    u:object_r:sysfs_ksm:s0

# USB gadget
/sys/devices/platform/musb-omap2430/musb-hdrc/gadget/lun0/file u:object_r:sysfs_gadget:s0

# rfkill device (bluetooth + wifi supplicant)
/dev/rfkill                                  u:object_r:rfkill_device:s0

# gps control socket (created by init)
/dev/socket/gps                              u:object_r:gps_socket:s0

# loggy.sh persistent-logging script (copied to the ramdisk root)
/loggy\.sh                                   u:object_r:loggy_exec:s0

