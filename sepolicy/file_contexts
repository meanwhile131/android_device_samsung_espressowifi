# Dock
/dev/ttyO3                                  u:object_r:dock_device:s0
/system/bin/dock_kbd_attach                 u:object_r:dock_kbd_attach_exec:s0

# DRM
/dev/tf_ctrl                                u:object_r:smc_device:s0
/system/bin/smc_pa_ctrl                     u:object_r:smc_pa_exec:s0

# GPS
/system/bin/gpsd                            u:object_r:gpsd_exec:s0

# Sensors
/data/sensors(/.*)?                         u:object_r:sensors_data_file:s0
/system/bin/geomagneticd                    u:object_r:geomagneticd_exec:s0
/system/bin/orientationd                    u:object_r:orientationd_exec:s0

# Bluetooth
/dev/ttyO1                                                   u:object_r:hci_attach_dev:s0
/efs/bluetooth(/.*)?                                         u:object_r:bluetooth_efs_file:s0
/sys/devices/platform/bcm4330_bluetooth/rfkill/rfkill0/state u:object_r:sysfs_bluetooth_writable:s0

# GPS
/dev/ttyO0                                  u:object_r:gps_device:s0

# Wifi
/efs/wifi/.mac.info                         u:object_r:wifi_data_file:s0

# Firmwares
/system/vendor/firmware/ducati-m3.bin       u:object_r:firmware_ducati:s0

# Block devices
/dev/block/platform/omap_hsmmc.1/by-name/EFS       u:object_r:efs_block_device:s0
/dev/block/platform/omap_hsmmc.1/by-name/MODEM     u:object_r:efs_block_device:s0
/dev/block/platform/omap_hsmmc.1/by-name/KERNEL    u:object_r:boot_block_device:s0
/dev/block/platform/omap_hsmmc.1/by-name/RECOVERY  u:object_r:recovery_block_device:s0
/dev/block/platform/omap_hsmmc.1/by-name/FACTORYFS u:object_r:system_block_device:s0
/dev/block/platform/omap_hsmmc.1/by-name/CACHE     u:object_r:cache_block_device:s0
/dev/block/platform/omap_hsmmc.1/by-name/DATAFS    u:object_r:userdata_block_device:s0

# Swap
/dev/block/zram(.*)                                     u:object_r:swap_block_device:s0

# sysfs
/sys/board/type                             u:object_r:sysfs_board_type:s0

# Battery (healthd)
/sys/devices/platform/i2c-gpio\.[0-9]+/.*/power_supply(/.*)?   u:object_r:sysfs_batteryinfo:s0

# Disk statistics (storaged)
/sys/devices/platform/omap_hsmmc\.[0-9]+/.*/block/mmcblk[0-9]+/stat   u:object_r:sysfs_disk_stat:s0

# I/O scheduler tuning done by init
/sys/devices/platform/omap_hsmmc\.[0-9]+/.*/block/mmcblk[0-9]+/queue(/.*)?   u:object_r:sysfs_espresso:s0

# WiFi
/sys/module/bcmdhd(/.*)?                    u:object_r:sysfs_wifi:s0
/dev/rfkill                                 u:object_r:rfkill_device:s0
/sys/devices/platform/bcm4330_bluetooth/rfkill(/.*)?   u:object_r:sysfs_bluetooth_writable:s0
/sys/devices/platform/omap_hsmmc\.[0-9]+/.*/rfkill[0-9]+(/.*)?   u:object_r:sysfs_espresso:s0

# USB gadget (mass storage backing file and friends)
/sys/devices/platform/musb-omap2430/musb-hdrc/gadget(/.*)?   u:object_r:sysfs_espresso:s0

# Input devices / sensors
/sys/devices/virtual/input(/.*)?            u:object_r:sysfs_input:s0
/sys/devices/virtual/sensors(/.*)?          u:object_r:sysfs_input:s0
/sys/devices/platform/omap_i2c\.[0-9]+/i2c-[0-9]+/[0-9]+-[0-9a-f]+/input(/.*)?   u:object_r:sysfs_input:s0

# GPS
/dev/socket/gps                             u:object_r:gps_socket:s0
/sys/devices/virtual/gpio/gpio173(/.*)?     u:object_r:sysfs_gps:s0
/sys/devices/virtual/gpio/gpio178(/.*)?     u:object_r:sysfs_gps:s0
/data/gps(/.*)?                             u:object_r:gps_data_file:s0

# sysfs nodes configured by init (switch/jig, backlight, KSM)
/sys/devices/virtual/sec(/.*)?              u:object_r:sysfs_espresso:s0
/sys/devices/omapdss/display0(/.*)?         u:object_r:sysfs_espresso:s0
/sys/kernel/mm/ksm(/.*)?                    u:object_r:sysfs_espresso:s0
