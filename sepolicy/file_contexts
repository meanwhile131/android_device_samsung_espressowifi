# owned by drmrpc on /system)
/system/bin/smc\.ini                         u:object_r:smc_data_file:s0
/system/bin/smc_pa\.ift                      u:object_r:smc_data_file:s0
/system/bin/smc_pa_ctrl                      u:object_r:smc_pa_exec:s0
/system/bin/tf_daemon                        u:object_r:tf_daemon_exec:s0

# Trustonic PA state dir (relabeled by init post-fs-data)
/data/smc(/.*)?                             u:object_r:smc_data_file:s0
