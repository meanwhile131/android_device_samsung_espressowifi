/sys/class/power_supply(/.*)?               u:object_r:sysfs_batteryinfo:s0
/sys/devices/platform/i2c-gpio.5/i2c-5/5-0006/power_supply(/.*)? u:object_r:sysfs_batteryinfo:s0
/sys/devices/platform/i2c-gpio.7/i2c-7/7-0036/power_supply(/.*)? u:object_r:sysfs_batteryinfo:s0

# storaged
/sys/devices/platform/omap_hsmmc.1/mmc_host/mmc0/mmc0:0001/block/mmcblk0/queue/stat u:object_r:sysfs_disk_stat:s0

# bcmdhd firmware path (wifi HAL)
/sys/module/bcmdhd/parameters/firmware_path  u:object_r:sysfs_wlan_fwpath:s0

