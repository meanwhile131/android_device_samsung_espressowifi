type gpsd, domain;
type gpsd_exec, exec_type, file_type;
init_daemon_domain(gpsd);

# gpsd - GPS daemon
allow gpsd rild:unix_stream_socket { connectto };
allow gpsd self:process { execmem };
allow gpsd sysfs_wake_lock:file { read write };

# Serial port used by the GPS chip
allow gpsd gps_device:chr_file rw_file_perms;

# Power/reset GPIOs exposed through sysfs
allow gpsd sysfs_gps:file rw_file_perms;

# Control pipe created by the framework
allow gpsd gps_data_file:dir w_dir_perms;
allow gpsd gps_data_file:fifo_file create_file_perms;

# DNS / fwmark lookups through netd
net_domain(gpsd)
