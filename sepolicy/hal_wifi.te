# bcmdhd firmware path is configured through a module parameter
allow hal_wifi_default sysfs_wifi:file rw_file_perms;
allow hal_wifi_supplicant_default sysfs_wifi:file rw_file_perms;

# wpa_supplicant opens /dev/rfkill directly
allow hal_wifi_supplicant_default rfkill_device:chr_file rw_file_perms;
allow hal_wifi_hostapd_default rfkill_device:chr_file rw_file_perms;
